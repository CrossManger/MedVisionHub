{
  "_meta": {
    "title": "MedVision Hub - API Contracts",
    "version": "1.0",
    "base_url": "http://localhost:8080/api/v1",
    "updated_at": "2026-07-27",
    "description": "Single Source of Truth cho toàn bộ API endpoints. Frontend và Backend phải code đúng theo contract này."
  },

  "auth": {
    "POST /auth/register": {
      "description": "Đăng ký tài khoản mới",
      "phase": 2,
      "request_body": {
        "username": "string (required, 3-100 chars)",
        "email": "string (required, valid email)",
        "password": "string (required, min 6 chars)",
        "full_name": "string (required)",
        "role": "string (optional, default: 'patient', enum: ['doctor', 'patient'])"
      },
      "response_201": {
        "message": "string",
        "user": {
          "id": "number",
          "username": "string",
          "email": "string",
          "full_name": "string",
          "role": "string"
        }
      },
      "response_400": { "error": "string (validation message)" },
      "response_409": { "error": "string (username/email đã tồn tại)" }
    },

    "POST /auth/login": {
      "description": "Đăng nhập và nhận JWT token",
      "phase": 2,
      "request_body": {
        "username": "string (required)",
        "password": "string (required)"
      },
      "response_200": {
        "token": "string (JWT)",
        "user": {
          "id": "number",
          "username": "string",
          "email": "string",
          "full_name": "string",
          "role": "string",
          "permissions": ["string"]
        }
      },
      "response_401": { "error": "string (sai tài khoản/mật khẩu)" }
    },

    "POST /auth/forgot-password": {
      "description": "Yêu cầu reset mật khẩu",
      "phase": 5,
      "request_body": { "email": "string (required)" },
      "response_200": { "message": "string" }
    },

    "POST /auth/reset-password": {
      "description": "Reset mật khẩu bằng token",
      "phase": 5,
      "request_body": {
        "token": "string (required)",
        "new_password": "string (required, min 6 chars)"
      },
      "response_200": { "message": "string" },
      "response_400": { "error": "string (token không hợp lệ/hết hạn)" }
    }
  },

  "patients": {
    "GET /patients": {
      "description": "Lấy danh sách bệnh nhân (phân trang)",
      "phase": 3,
      "auth_required": true,
      "permission": "can_view_patient",
      "query_params": {
        "page": "number (default: 1)",
        "limit": "number (default: 10, max: 100)",
        "search": "string (optional, tìm theo tên)"
      },
      "response_200": {
        "data": [
          {
            "id": "number",
            "full_name": "string",
            "date_of_birth": "string (YYYY-MM-DD)",
            "gender": "string",
            "phone": "string",
            "created_at": "string (ISO 8601)"
          }
        ],
        "pagination": {
          "page": "number",
          "limit": "number",
          "total": "number",
          "total_pages": "number"
        }
      }
    },

    "GET /patients/:id": {
      "description": "Xem chi tiết hồ sơ bệnh nhân",
      "phase": 3,
      "auth_required": true,
      "permission": "can_view_patient",
      "response_200": {
        "id": "number",
        "user_id": "number | null",
        "full_name": "string",
        "date_of_birth": "string",
        "gender": "string",
        "phone": "string",
        "address": "string",
        "medical_history": "string",
        "created_by": "number",
        "created_at": "string",
        "updated_at": "string",
        "scan_sessions": [
          {
            "id": "number",
            "scan_type": "string",
            "status": "string",
            "created_at": "string",
            "image_count": "number"
          }
        ]
      },
      "response_404": { "error": "string" }
    },

    "POST /patients": {
      "description": "Tạo hồ sơ bệnh nhân mới",
      "phase": 3,
      "auth_required": true,
      "permission": "can_create_patient",
      "request_body": {
        "full_name": "string (required)",
        "date_of_birth": "string (optional, YYYY-MM-DD)",
        "gender": "string (optional, enum: ['male', 'female', 'other'])",
        "phone": "string (optional)",
        "address": "string (optional)",
        "medical_history": "string (optional)"
      },
      "response_201": {
        "message": "string",
        "patient": { "id": "number", "full_name": "string" }
      }
    },

    "PUT /patients/:id": {
      "description": "Cập nhật hồ sơ bệnh nhân",
      "phase": 3,
      "auth_required": true,
      "permission": "can_edit_patient",
      "request_body": {
        "full_name": "string (optional)",
        "date_of_birth": "string (optional)",
        "gender": "string (optional)",
        "phone": "string (optional)",
        "address": "string (optional)",
        "medical_history": "string (optional)"
      },
      "response_200": { "message": "string" }
    },

    "DELETE /patients/:id": {
      "description": "Xóa hồ sơ bệnh nhân",
      "phase": 3,
      "auth_required": true,
      "permission": "can_delete_patient",
      "response_200": { "message": "string" },
      "response_404": { "error": "string" }
    }
  },

  "scan_sessions": {
    "POST /patients/:patient_id/scans": {
      "description": "Tạo ca chụp mới cho bệnh nhân",
      "phase": 4,
      "auth_required": true,
      "permission": "can_create_scan",
      "request_body": {
        "scan_type": "string (required, enum: ['xray', 'mri', 'ct_scan', 'ultrasound'])",
        "notes": "string (optional)"
      },
      "response_201": {
        "message": "string",
        "scan_session": { "id": "number", "scan_type": "string", "status": "string" }
      }
    },

    "GET /patients/:patient_id/scans": {
      "description": "Lấy danh sách ca chụp của bệnh nhân",
      "phase": 4,
      "auth_required": true,
      "response_200": {
        "data": [
          {
            "id": "number",
            "scan_type": "string",
            "status": "string",
            "notes": "string",
            "doctor_name": "string",
            "image_count": "number",
            "created_at": "string"
          }
        ]
      }
    },

    "PUT /scans/:id/complete": {
      "description": "Đánh dấu ca chụp hoàn tất (trigger notification)",
      "phase": 6,
      "auth_required": true,
      "permission": "can_create_scan",
      "request_body": {
        "diagnostic_result": "string (optional, ghi kết quả chẩn đoán)"
      },
      "response_200": { "message": "string" }
    }
  },

  "images": {
    "POST /scans/:scan_id/images": {
      "description": "Upload hình ảnh y tế cho ca chụp",
      "phase": 4,
      "auth_required": true,
      "permission": "can_upload_image",
      "content_type": "multipart/form-data",
      "request_body": {
        "file": "File (required, max 10MB, types: jpg/jpeg/png/dicom)"
      },
      "response_201": {
        "message": "string",
        "image": {
          "id": "number",
          "file_name": "string",
          "file_url": "string",
          "file_size": "number",
          "mime_type": "string"
        }
      },
      "response_400": { "error": "string (file không hợp lệ)" }
    },

    "GET /scans/:scan_id/images": {
      "description": "Lấy danh sách hình ảnh của ca chụp",
      "phase": 4,
      "auth_required": true,
      "permission": "can_view_image",
      "response_200": {
        "data": [
          {
            "id": "number",
            "file_name": "string",
            "file_url": "string",
            "file_size": "number",
            "mime_type": "string",
            "diagnostic_result": "string | null",
            "uploaded_by": "string",
            "created_at": "string"
          }
        ]
      }
    },

    "DELETE /images/:id": {
      "description": "Xóa hình ảnh y tế",
      "phase": 4,
      "auth_required": true,
      "permission": "can_upload_image",
      "response_200": { "message": "string" }
    }
  },

  "permissions": {
    "GET /admin/roles": {
      "description": "Lấy danh sách roles kèm permissions",
      "phase": 5,
      "auth_required": true,
      "permission": "can_manage_permissions",
      "response_200": {
        "data": [
          {
            "id": "number",
            "name": "string",
            "description": "string",
            "permissions": [
              { "id": "number", "name": "string", "description": "string" }
            ]
          }
        ]
      }
    },

    "GET /admin/permissions": {
      "description": "Lấy danh sách tất cả permissions",
      "phase": 5,
      "auth_required": true,
      "permission": "can_manage_permissions",
      "response_200": {
        "data": [
          { "id": "number", "name": "string", "description": "string" }
        ]
      }
    },

    "PUT /admin/roles/:role_id/permissions": {
      "description": "Cập nhật permissions cho role (tích/bỏ tích)",
      "phase": 5,
      "auth_required": true,
      "permission": "can_manage_permissions",
      "request_body": {
        "permission_ids": ["number"]
      },
      "response_200": { "message": "string" }
    }
  },

  "notifications": {
    "GET /notifications": {
      "description": "Lấy danh sách thông báo của user hiện tại",
      "phase": 6,
      "auth_required": true,
      "query_params": {
        "unread_only": "boolean (optional, default: false)"
      },
      "response_200": {
        "data": [
          {
            "id": "number",
            "title": "string",
            "message": "string",
            "type": "string",
            "is_read": "boolean",
            "related_entity": "string",
            "related_id": "number",
            "created_at": "string"
          }
        ],
        "unread_count": "number"
      }
    },

    "PUT /notifications/:id/read": {
      "description": "Đánh dấu thông báo đã đọc",
      "phase": 6,
      "auth_required": true,
      "response_200": { "message": "string" }
    },

    "WebSocket /ws/notifications": {
      "description": "Kết nối WebSocket nhận thông báo realtime",
      "phase": 6,
      "auth_required": true,
      "auth_method": "JWT token gửi qua query param: ?token=xxx",
      "events": {
        "new_notification": {
          "title": "string",
          "message": "string",
          "type": "string",
          "related_entity": "string",
          "related_id": "number"
        }
      }
    }
  }
}
